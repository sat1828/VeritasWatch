# .streamlit/secrets.toml.example
# Copy this to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to GitHub.
#
# On Streamlit Community Cloud:
#   Go to your app → Settings → Secrets
#   Paste the contents of this file with your real values filled in.
#
# The dashboard itself does NOT need API credentials to run in demo mode.
# Only src/collector.py needs X_BEARER_TOKEN for live data collection.

[api_keys]
X_BEARER_TOKEN = "your_bearer_token_here"
